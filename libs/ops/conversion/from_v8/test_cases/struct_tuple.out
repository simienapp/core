impl<'a> ::simien_core::convert::FromV8<'a> for Tuple {
    type Error = ::simien_error::JsErrorBox;
    fn from_v8<'i>(
        __scope: &mut ::simien_core::v8::PinScope<'a, 'i>,
        __value: ::simien_core::v8::Local<'a, ::simien_core::v8::Value>,
    ) -> Result<Self, Self::Error> {
        let __array = ::simien_core::v8::Local::<
            ::simien_core::v8::Array,
        >::try_from(__value)
            .map_err(|err| ::simien_error::JsErrorBox::from_err(
                ::simien_core::error::DataError::from(err),
            ))?;
        Ok(
            Self(
                {
                    let __element_value = __array
                        .get_index(__scope, 0u32)
                        .ok_or_else(|| ::simien_error::JsErrorBox::type_error(
                            concat!("Missing element ", 0u32, " on '", "Tuple", "'"),
                        ))?;
                    ::simien_core::simien_serde_v8::from_v8(__scope, __element_value)
                        .map_err(::simien_error::JsErrorBox::from_err)?
                },
                {
                    let __element_value = __array
                        .get_index(__scope, 1u32)
                        .ok_or_else(|| ::simien_error::JsErrorBox::type_error(
                            concat!("Missing element ", 1u32, " on '", "Tuple", "'"),
                        ))?;
                    ::simien_core::convert::FromV8::from_v8(__scope, __element_value)
                        .map_err(::simien_error::JsErrorBox::from_err)?
                },
            ),
        )
    }
}
