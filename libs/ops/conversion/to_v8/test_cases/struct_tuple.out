impl<'a> ::simien_core::convert::ToV8<'a> for Tuple {
    type Error = ::simien_error::JsErrorBox;
    fn to_v8<'i>(
        self,
        __scope: &mut ::simien_core::v8::PinScope<'a, 'i>,
    ) -> Result<::simien_core::v8::Local<'a, ::simien_core::v8::Value>, Self::Error> {
        let Self { 0: __0, 1: __1 } = self;
        let __value = &[
            ::simien_core::simien_serde_v8::to_v8(__scope, __0)
                .map_err(::simien_error::JsErrorBox::from_err)?,
            ::simien_core::convert::ToV8::to_v8(__1, __scope)
                .map_err(::simien_error::JsErrorBox::from_err)?,
        ];
        Ok::<
            _,
            ::simien_error::JsErrorBox,
        >(::simien_core::v8::Array::new_with_elements(__scope, __value).into())
    }
}
